{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecuredStorage",
  "version": "1.0.0",
  "identifier": "com.securedstorage.vault",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "SecuredStorage - PQC Vault",
        "width": 1020,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "frameworks": ["LocalAuthentication"],
      "minimumSystemVersion": "11.0"
    }
  }
}
